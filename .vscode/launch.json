{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "InvoiceApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/InvoiceApi/bin/Debug/net8.0/InvoiceApi.dll",
      "cwd": "${workspaceFolder}/src/InvoiceApi",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "stopAtEntry": false
    }
  ]
}
